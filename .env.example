# Optional local-only override. Default: .local-data/dashboard.json
# TRAVELOS_DATA_FILE=/absolute/path/to/dashboard.json
# PostgreSQL connection is not implemented yet.

# Supabase Auth: public project URL and publishable key (NOT service_role).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional fallback for projects using the legacy anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Existing local workspace is not multi-tenant yet.
# Only explicitly authorized Supabase Auth user IDs may access it.
# Empty list means no signed-in account can access the local workspace.
TRAVELOS_WORKSPACE_USER_IDS=

# Explicit loopback-only production preview without configured Auth.
# Leave unset for deployment. Development (pnpm dev) works locally without Auth.
# TRAVELOS_LOCAL_PREVIEW=1
